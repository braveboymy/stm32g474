#!/usr/bin/env bash
# pre-commit 钩子：提交前自动执行 编译 + MISRA C:2012 + clang-format 格式检查
# 安装：bash tools/install_hooks.sh（设置 git core.hooksPath）
# 跳过（紧急提交）：SKIP_CHECKS=1 git commit ... 或 git commit --no-verify
set -uo pipefail

# 项目根：git 运行钩子时 cwd 恒为仓库根；手动调用时向上查找 devtool.conf
ROOT="$(pwd)"
if [ ! -f "$ROOT/devtool.conf" ]; then
  d="$(cd "$(dirname "$0")" && pwd)"
  while [ "$d" != "/" ] && [ ! -f "$d/devtool.conf" ]; do d="$(dirname "$d")"; done
  [ -f "$d/devtool.conf" ] && ROOT="$d"
fi
DEV="$ROOT/.pi/skills/stm32g474-devtools/scripts/dev.py"

if [ "${SKIP_CHECKS:-0}" = "1" ]; then
  echo "==> [pre-commit] SKIP_CHECKS=1，跳过编译/MISRA/格式检查"
  exit 0
fi

cd "$ROOT" || exit 1

FAILED=0

echo "==> [pre-commit] 编译检查（ninja 增量）"
if python "$DEV" build > /tmp/precommit_build.log 2>&1; then
  echo "    ✅ 编译通过"
else
  echo "    ❌ 编译失败："
  tail -20 /tmp/precommit_build.log | sed 's/^/      /'
  FAILED=1
fi

echo "==> [pre-commit] core 层 PC 单测"
if python "$DEV" test > /tmp/precommit_test.log 2>&1; then
  echo "    ✅ 单测通过"
else
  echo "    ❌ 单测失败："
  tail -20 /tmp/precommit_test.log | sed 's/^/      /'
  FAILED=1
fi

echo "==> [pre-commit] MISRA C:2012 检查"
if python "$DEV" misra > /tmp/precommit_misra.log 2>&1; then
  echo "    ✅ 无 MISRA 违规"
else
  echo "    ❌ MISRA 违规："
  tail -20 /tmp/precommit_misra.log | sed 's/^/      /'
  FAILED=1
fi

echo "==> [pre-commit] clang-format 格式检查（仅改动文件）"
if command -v clang-format > /dev/null 2>&1; then
  # 收集本次改动的 C/H 文件（已暂存 + 未暂存）
  FILES=$(git diff --cached --name-only --diff-filter=ACM '*.c' '*.h' 2>/dev/null; \
          git diff --name-only --diff-filter=ACM '*.c' '*.h' 2>/dev/null)
  # 排除第三方/生成代码（第三方不改不评，见 AGENTS.md）
  FILES=$(echo "$FILES" | grep -vE "bsp/system/|bsp/startup/|bsp/linker/|third_party/" || true)
  FMT_FAIL=0
  for f in $FILES; do
    [ -f "$f" ] || continue
    if ! clang-format --style=file --dry-run --Werror "$f" > /dev/null 2>&1; then
      echo "    ❌ 格式不符: $f（运行 clang-format -i $f）"
      FMT_FAIL=1
    fi
  done
  if [ "$FMT_FAIL" -eq 0 ]; then
    echo "    ✅ 格式合规"
  else
    FAILED=1
  fi
else
  echo "    ⚠️ 未安装 clang-format（pip install clang-format），跳过格式检查"
fi

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "==> [pre-commit] 提交被阻止。处置："
  echo "    1. 修复上述问题后重新提交"
  echo "    2. 紧急跳过：SKIP_CHECKS=1 git commit ...（或 git commit --no-verify）"
  exit 1
fi

echo "==> [pre-commit] 全部检查通过"
exit 0
